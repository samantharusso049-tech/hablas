<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>

<meta name="color-scheme" content="light only">
<meta name="theme-color" content="#FFFFFF">
<title>Hablas</title>
<meta name="claude:viewport-fit-sides" content="cover">
<style>
/* Hablas v4: white, light and friendly. No web fonts: system fonts only. */
:root {
  --bg: #FFFFFF; --card: #FFFFFF; --ink: #23263A; --ink2: #6B6F80; --line: #ECECF1; --soft: #FAFAFC;
  --blue: #3B6CF6; --blue-soft: #EEF3FF; --es: #C2255C; --es-soft: #FFF0F5;
  --red: #E5484D; --red-soft: #FFF0F0; --orange: #F08C00; --orange-soft: #FFF4E5;
  --green: #2F9E44; --green-soft: #EBFBEE; --teal: #0C8599; --yellow-soft: #FFF9DB; --purple: #7048E8;
  --ui: ui-rounded, "SF Pro Rounded", "Nunito", "Segoe UI", system-ui, -apple-system, Roboto, sans-serif;
  --serif: ui-serif, "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, "Times New Roman", serif;
  color-scheme: light only;
}
* { box-sizing: border-box; }
html, body { height: 100%; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 17px/1.5 var(--ui); -webkit-text-size-adjust: 100%; }
button, input, select { font: inherit; color: inherit; }
button { cursor: pointer; }
:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; border-radius: 8px; }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
#app { max-width: 620px; margin: 0 auto; min-height: 100%; display: flex; flex-direction: column;
  padding: env(safe-area-inset-top, 0) 0 env(safe-area-inset-bottom, 0); }
main { flex: 1; padding-block: 16px 96px; padding-left: max(18px, env(safe-area-inset-left, 0px)); padding-right: max(18px, env(safe-area-inset-right, 0px)); }
h1 { font-size: 28px; line-height: 1.15; margin: 4px 0 6px; font-weight: 800; }
h2 { font-size: 20px; margin: 26px 0 10px; font-weight: 800; }
h3 { font-size: 17px; margin: 0 0 4px; font-weight: 800; }
p { margin: 0 0 10px; }
.muted { color: var(--ink2); }
.small { font-size: 14.5px; }
.es { font-family: var(--serif); color: var(--es); }

/* buttons */
.btn { min-height: 48px; padding: 10px 20px; border-radius: 999px; border: 1.5px solid var(--line); background: #fff; font-weight: 800;
  display: inline-flex; align-items: center; justify-content: center; gap: 8px; }
.btn:hover { border-color: #C9CCD8; }
.btn.primary { background: var(--blue); border-color: var(--blue); color: #fff; box-shadow: 0 6px 16px -8px var(--blue); }
.btn.big { width: 100%; min-height: 56px; font-size: 19px; }
.btn.ghost { border-color: transparent; background: transparent; color: var(--blue); }
.btn:disabled { opacity: .45; cursor: default; }
.chip { display: inline-flex; align-items: center; gap: 6px; padding: 6px 13px; border-radius: 999px; border: 1.5px solid var(--line);
  background: #fff; font-size: 15px; font-weight: 700; min-height: 36px; }
.chip[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: #fff; }
.chips { display: flex; flex-wrap: wrap; gap: 8px; }
.icon-btn { width: 44px; height: 44px; border-radius: 50%; border: 0; background: transparent; display: inline-grid; place-items: center; color: var(--ink2); }
.icon-btn svg { width: 24px; height: 24px; }
.play { display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; min-height: 42px; border-radius: 999px; border: 1.5px solid var(--blue);
  color: var(--blue); background: #fff; font-weight: 800; font-size: 15px; }
.play svg { width: 16px; height: 16px; fill: currentColor; }
.play.round { width: 44px; height: 44px; padding: 0; justify-content: center; }
.star-btn[aria-pressed="true"] { color: #F59F00; }
.star-btn svg { fill: none; stroke: currentColor; stroke-width: 2; }
.star-btn[aria-pressed="true"] svg { fill: currentColor; }

/* home */
.top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px; }
.logo { font-weight: 900; font-size: 22px; letter-spacing: -.02em; }
.logo span { color: var(--es); }
.streak { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 999px; background: var(--orange-soft); color: #B35C00; font-weight: 800; }
.streak svg { width: 18px; height: 18px; }
.hello { font-family: var(--serif); color: var(--es); font-size: 34px; margin: 12px 0 0; }
.plan { border: 1.5px solid var(--line); border-radius: 24px; padding: 20px; margin-top: 16px; background: #fff; }
.plan-nums { display: flex; gap: 10px; margin: 6px 0 14px; flex-wrap: wrap; }
.pill { border-radius: 16px; padding: 10px 14px; font-weight: 700; flex: 1; min-width: 120px; }
.pill b { display: block; font-size: 26px; line-height: 1.1; }
.pill.rev { background: #E7F5FF; color: #1864AB; }
.pill.new { background: var(--yellow-soft); color: #946200; }
.modes { margin: 4px 0 14px; }
.modes p { font-size: 14.5px; color: var(--ink2); margin-bottom: 8px; }
.stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 12px; }
.stat { border-radius: 18px; padding: 12px; text-align: center; }
.stat b { display: block; font-size: 26px; }
.stat span { font-size: 13.5px; font-weight: 700; }
.stat:nth-child(1) { background: #F3F0FF; color: #5F3DC4; }
.stat:nth-child(2) { background: #E6FCF5; color: #087F5B; }
.stat:nth-child(3) { background: #FFF4E6; color: #D9480F; }
.cats { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
.cat { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; padding: 12px; border-radius: 20px; border: 1.5px solid var(--line);
  background: #fff; text-align: left; }
.cat svg { width: 56px; height: 56px; }
.cat b { font-size: 15px; line-height: 1.25; }
.bar { width: 100%; height: 6px; border-radius: 3px; background: var(--line); overflow: hidden; }
.bar i { display: block; height: 100%; background: var(--green); border-radius: 3px; }
.card-link { display: flex; align-items: center; gap: 14px; width: 100%; padding: 16px; border-radius: 20px; border: 1.5px solid var(--line); background: #fff; text-align: left; margin-top: 10px; }
.card-link .big-ic { width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center; background: #F3F0FF; color: var(--purple); flex-shrink: 0; }
.card-link .big-ic svg { width: 26px; height: 26px; }
.notice { padding: 12px 14px; border-radius: 14px; background: var(--yellow-soft); color: #7A5200; font-size: 15px; margin-top: 12px; }
.notice.info { background: #E7F5FF; color: #1864AB; }
.settings { border-top: 1.5px solid var(--line); margin-top: 30px; padding-top: 6px; }
.row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
textarea { width: 100%; min-height: 90px; border: 1.5px solid var(--line); border-radius: 12px; padding: 10px; font: 13px/1.4 ui-monospace, monospace; }

/* nav */
nav.tabs { position: fixed; left: 0; right: 0; bottom: 0; background: rgba(255,255,255,.96); border-top: 1.5px solid var(--line);
  display: flex; justify-content: center; padding-bottom: env(safe-area-inset-bottom, 0px); padding-left: env(safe-area-inset-left, 0px); padding-right: env(safe-area-inset-right, 0px); z-index: 5; }
nav.tabs .in { display: flex; width: 100%; max-width: 620px; }
nav.tabs button { flex: 1; border: 0; background: none; padding: 9px 0 10px; display: flex; flex-direction: column; align-items: center; gap: 2px;
  font-size: 12.5px; font-weight: 700; color: var(--ink2); }
nav.tabs svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
nav.tabs [aria-current="page"] { color: var(--blue); }

/* lists */
.search { width: 100%; min-height: 48px; padding: 10px 16px; border-radius: 999px; border: 1.5px solid var(--line); font-size: 17px; }
.filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0 6px; }
select { min-height: 40px; border-radius: 999px; border: 1.5px solid var(--line); padding: 6px 12px; background: #fff; font-weight: 700; font-size: 15px; }
.wlist { list-style: none; padding: 0; margin: 8px 0 0; }
.wlist li { display: flex; align-items: center; gap: 12px; padding: 8px 0; border-bottom: 1.5px solid var(--line); }
.wlist .pic { width: 52px; height: 52px; flex-shrink: 0; }
.wlist .open { flex: 1; display: flex; flex-direction: column; align-items: flex-start; border: 0; background: none; text-align: left; padding: 4px 0; min-width: 0; }
.wlist .open .es { font-size: 20px; }
.wlist .open span:last-child { font-size: 14.5px; color: var(--ink2); }
.dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; margin-right: 4px; vertical-align: middle; background: var(--line); }
.dot.learning { background: #FFD43B; } .dot.familiar { background: #69DB7C; } .dot.mastered { background: var(--green); }

/* study */
.study { min-height: 100vh; min-height: 100dvh; display: flex; flex-direction: column; }
.sbar { display: flex; align-items: center; gap: 12px; padding-block: 8px; padding-left: max(12px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
.progress { flex: 1; height: 8px; border-radius: 4px; background: var(--line); overflow: hidden; }
.progress i { display: block; height: 100%; background: var(--blue); border-radius: 4px; transition: width .25s; }
.count { font-size: 14px; color: var(--ink2); font-weight: 700; min-width: 54px; text-align: right; }
.sbody { flex: 1; padding-block: 6px 20px; padding-left: max(18px, env(safe-area-inset-left, 0px)); padding-right: max(18px, env(safe-area-inset-right, 0px)); display: flex; flex-direction: column; }
.face { text-align: center; padding: 10px 0 0; }
.face .pic { width: 170px; height: 170px; margin: 0 auto 6px; display: block; }
.face .pic svg { width: 100%; height: 100%; }
.face .en { font-size: 28px; font-weight: 800; margin: 8px 0 4px; }
.face .prompt { color: var(--ink2); font-weight: 700; }
.kind { display: inline-block; font-size: 13px; font-weight: 800; padding: 3px 12px; border-radius: 999px; margin-bottom: 6px; }
.k-flash { background: var(--yellow-soft); color: #946200; } .k-type { background: var(--green-soft); color: var(--green); }
.k-mc { background: #F3F0FF; color: var(--purple); } .k-listen, .k-spell { background: #E7F5FF; color: #1864AB; } .k-blank { background: var(--orange-soft); color: #B35C00; }
.answer-in { width: 100%; max-width: 420px; display: block; margin: 12px auto 6px; min-height: 54px; font: 26px var(--serif); color: var(--es);
  text-align: center; border: 2px solid var(--line); border-radius: 16px; padding: 8px 12px; }
.answer-in:focus { border-color: var(--blue); outline: none; }
.answer-in.ok { border-color: var(--green); } .answer-in.bad { border-color: var(--red); color: var(--red); }
.accents { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin: 6px 0; }
.accents button { width: 42px; height: 42px; border-radius: 12px; border: 1.5px solid var(--line); background: #fff; font: 20px var(--serif); color: var(--es); }
.mc { display: grid; gap: 10px; max-width: 460px; margin: 14px auto 0; width: 100%; }
.mc button { min-height: 54px; border-radius: 16px; border: 1.5px solid var(--line); background: #fff; font-weight: 700; text-align: left; padding: 10px 16px;
  display: flex; gap: 12px; align-items: center; }
.mc button kbd { font: 700 13px var(--ui); color: var(--ink2); border: 1.5px solid var(--line); border-radius: 6px; padding: 0 6px; }
.mc button.right { border-color: var(--green); background: var(--green-soft); }
.mc button.wrong { border-color: var(--red); background: var(--red-soft); }
.bigword { font-size: 44px; font-family: var(--serif); color: var(--es); margin: 10px 0 6px; line-height: 1.1; }
.listen-btn { width: 96px; height: 96px; border-radius: 50%; border: 0; background: var(--blue); color: #fff; display: grid; place-items: center; margin: 14px auto 6px;
  box-shadow: 0 10px 24px -12px var(--blue); }
.listen-btn svg { width: 40px; height: 40px; fill: #fff; margin-left: 5px; }
.sentence { font: 25px/1.45 var(--serif); color: var(--es); margin: 14px 0 4px; }
.gap { display: inline-block; min-width: 3.4em; border-bottom: 3px solid var(--ink2); }
.feedback { border-radius: 16px; padding: 12px 16px; margin: 14px 0 0; font-weight: 700; }
.feedback.ok { background: var(--green-soft); color: var(--green); }
.feedback.bad { background: var(--red-soft); color: #C92A2A; }
.feedback .es { font-weight: 400; font-size: 20px; }
.actions { position: sticky; bottom: 0; background: linear-gradient(transparent, #fff 22%); padding: 18px 0 8px; margin-top: auto; }
.rate { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
.rate button { border-radius: 16px; border: 0; padding: 10px 4px; font-weight: 800; display: flex; flex-direction: column; align-items: center; gap: 1px; min-height: 60px; }
.rate button small { font-weight: 700; font-size: 12.5px; opacity: .8; }
.rate .r1 { background: var(--red-soft); color: #C92A2A; } .rate .r2 { background: var(--orange-soft); color: #B35C00; }
.rate .r3 { background: var(--green-soft); color: var(--green); } .rate .r4 { background: #E7F5FF; color: #1864AB; }
.keyhint { text-align: center; font-size: 13px; color: var(--ink2); margin-top: 8px; }

/* back of the card */
.back { text-align: left; margin-top: 14px; }
.back .head { display: flex; align-items: center; gap: 14px; }
.back .head .pic { width: 84px; height: 84px; flex-shrink: 0; }
.back .word { font-family: var(--serif); color: var(--es); font-size: 40px; line-height: 1.1; }
.back .word .art { color: #E58FB1; }
.approx { color: var(--ink2); font-size: 15.5px; margin-top: 2px; }
.approx b { font-weight: 800; letter-spacing: .02em; color: var(--ink); }
.approx em { font-style: normal; font-size: 12px; font-weight: 800; color: var(--ink2); border: 1.5px solid var(--line); border-radius: 6px; padding: 0 5px; margin-right: 6px; }
.audio-row { display: flex; gap: 8px; margin: 10px 0 2px; flex-wrap: wrap; align-items: center; }
.ess { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0 0; }
.ess span { font-size: 14px; font-weight: 700; padding: 4px 10px; border-radius: 999px; background: var(--soft); border: 1.5px solid var(--line); }
.ess span.g-m { background: #E7F5FF; border-color: #D0EBFF; color: #1864AB; }
.ess span.g-f { background: #FFF0F6; border-color: #FFDEEB; color: #A61E4D; }
.ess span.es-chip { font-family: var(--serif); color: var(--es); font-weight: 400; font-size: 16px; }
.example { margin-top: 14px; padding: 14px 16px; border-radius: 18px; background: var(--soft); border: 1.5px solid var(--line); }
.example .s { font: 21px/1.45 var(--serif); color: var(--es); }
.example .s mark { background: #FFE8F0; color: inherit; border-radius: 4px; padding: 0 2px; }
.example .t { color: var(--ink2); margin-top: 2px; }
details.gram { margin-top: 12px; border: 1.5px solid var(--line); border-radius: 18px; padding: 0 16px; }
details.gram summary { padding: 13px 0; font-weight: 800; cursor: pointer; }
.gtable { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
.gtable td { padding: 7px 4px; border-top: 1.5px solid var(--line); }
.gtable td:first-child { color: var(--ink2); font-size: 15px; width: 45%; }
.gtable button { border: 0; background: none; padding: 0; font: 19px var(--serif); color: var(--es); text-align: left; }
.notes { display: grid; gap: 8px; margin-top: 12px; }
.note { border-radius: 14px; padding: 10px 14px; font-size: 15.5px; background: var(--yellow-soft); }
.note b { display: block; font-size: 12.5px; text-transform: uppercase; letter-spacing: .04em; }
.note.warn { background: var(--red-soft); } .note.role { background: #F3F0FF; } .note.also { background: var(--green-soft); }

/* sheet (word detail) */
.sheet-wrap { position: fixed; inset: 0; background: rgba(20, 22, 40, .35); display: flex; align-items: flex-end; justify-content: center; z-index: 20; }
.sheet { background: #fff; width: 100%; max-width: 620px; max-height: 88vh; overflow-y: auto; border-radius: 26px 26px 0 0; padding: 12px 20px calc(24px + env(safe-area-inset-bottom, 0)); }
.sheet .bar-top { display: flex; justify-content: space-between; align-items: center; }

/* lessons */
.lesson-part { margin: 14px 0; }
.lesson-part .chips button { font-family: var(--serif); color: var(--es); font-size: 18px; font-weight: 400; }
.ex-line { display: flex; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1.5px solid var(--line); }
.ex-line .s { font: 20px var(--serif); color: var(--es); }
.done-mark { color: var(--green); font-weight: 800; font-size: 14px; }

/* done */
.done-box { text-align: center; padding: 30px 0; }
.done-box .big { font: 44px var(--serif); color: var(--es); }
.done-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 18px 0; }

@media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
@media (min-width: 640px) { main { padding-block: 22px 96px; padding-left: max(24px, env(safe-area-inset-left, 0px)); padding-right: max(24px, env(safe-area-inset-right, 0px)); } }

.pic svg { width: 100%; height: 100%; display: block; }

/* home: compact sizes so the page fits more smoothly */
.home { font-size: 15px; }
.home h1 { font-size: 21px; margin: 0 0 4px; }
.home h2 { font-size: 16px; margin: 20px 0 8px; }
.home .logo { font-size: 18px; }
.home .streak { font-size: 13px; padding: 4px 10px; }
.home .streak svg { width: 15px; height: 15px; }
.home .hello { font-size: 24px; margin-top: 6px; }
.home .hello + .muted { font-size: 13.5px; margin-bottom: 4px; }
.home .notice { font-size: 13.5px; padding: 10px 12px; margin-top: 10px; }
.home .plan { padding: 14px; border-radius: 20px; margin-top: 12px; }
.home .plan-nums { gap: 8px; margin: 4px 0 10px; }
.home .pill { padding: 8px 12px; border-radius: 14px; font-size: 13px; min-width: 110px; }
.home .pill b { font-size: 20px; }
.home .modes { margin: 2px 0 10px; }
.home .modes p { font-size: 13px; margin-bottom: 6px; }
.home .chips { gap: 6px; }
.home .chip { font-size: 13px; padding: 4px 11px; min-height: 32px; }
.home .btn { min-height: 42px; padding: 8px 16px; font-size: 14.5px; }
.home .btn.big { min-height: 48px; font-size: 16px; }
.home .stats { gap: 8px; margin-top: 10px; }
.home .stat { padding: 8px; border-radius: 14px; }
.home .stat b { font-size: 20px; }
.home .stat span { font-size: 12px; }
.home .small { font-size: 13px; }
.home .card-link { padding: 12px; border-radius: 16px; gap: 12px; }
.home .card-link .big-ic { width: 38px; height: 38px; border-radius: 11px; }
.home .card-link .big-ic svg { width: 21px; height: 21px; }
.home .cats { grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: 8px; }
.home .cat { padding: 9px; border-radius: 16px; gap: 4px; }
.home .cat svg { width: 40px; height: 40px; }
.home .cat b { font-size: 12.5px; line-height: 1.2; }
.home .cat .small { font-size: 11.5px; }
.home .bar { height: 4px; }
.home .settings { margin-top: 24px; }

/* ── v4.1: verb forms, sentences, readings, writing, A1 goal ── */
nav.tabs button { font-size: 11.5px; }
.back-btn { padding-left: 4px; margin-left: -4px; }
.pill.verb { background: #EBFBEE; color: #2B8A3E; }
.pill.sent { background: #F3F0FF; color: #5F3DC4; }
.home .pill { min-width: 0; flex: 1 1 40%; }
.k-conj { background: #EBFBEE; color: #2B8A3E; } .k-slisten, .k-sread { background: #E7F5FF; color: #1864AB; }
.k-sbuild { background: var(--orange-soft); color: #B35C00; } .k-ssay { background: #FFF0F6; color: #A61E4D; }
.conj-q { display: flex; justify-content: center; align-items: baseline; flex-wrap: wrap; gap: 10px; margin: 6px 0 2px; font-size: 30px; }
.conj-q .plus { color: var(--ink2); font-size: 22px; }
.mid-en { font-size: 23px !important; line-height: 1.3; }
.small-en { font-size: 20px !important; }
.answer-in::placeholder { color: #B8BBC6; font-size: 18px; }
.gtable tr.hl td { background: var(--yellow-soft); }
.chip.es-c { font-family: var(--serif); color: var(--es); font-weight: 400; font-size: 18px; }
/* tappable words */
.toks { font-family: var(--serif); color: var(--es); }
.tok { border: 0; background: none; padding: 0 1px; margin: 0; font: inherit; color: inherit; border-radius: 4px; border-bottom: 1.5px dotted rgba(194, 37, 92, .35); }
.tok:hover, .tok:focus-visible { background: var(--es-soft); }
.sentence .toks, .example .toks { font-size: 23px; line-height: 1.5; }
.glossbar { position: fixed; left: 0; right: 0; bottom: calc(66px + env(safe-area-inset-bottom, 0px)); z-index: 15; display: flex; justify-content: center;
  padding-left: max(12px, env(safe-area-inset-left, 0px)); padding-right: max(12px, env(safe-area-inset-right, 0px)); }
.glossbar > * { flex-shrink: 0; }
.glossbar { gap: 8px; align-items: center; }
.glossbar > div { flex: 0 1 520px; min-width: 0; background: var(--ink); color: #fff; border-radius: 16px; padding: 10px 14px; font-size: 15px; box-shadow: 0 10px 24px -10px rgba(0,0,0,.4); }
.glossbar > div b { font-family: var(--serif); font-weight: 400; font-size: 19px; color: #FFD8E6; margin-right: 6px; }
.glossbar .muted { color: #C9CCD8; }
.glossbar .btn, .glossbar .icon-btn { background: #fff; border: 1.5px solid var(--line); box-shadow: 0 6px 16px -10px rgba(0,0,0,.4); }
.study ~ .glossbar, .study + .glossbar { bottom: calc(150px + env(safe-area-inset-bottom, 0px)); }
/* sentence building */
.tiles { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
.tiles.answer { min-height: 58px; padding: 10px; border-radius: 16px; border: 2px dashed var(--line); margin: 12px 0; align-items: center; }
.tiles.answer.ok { border-style: solid; border-color: var(--green); background: var(--green-soft); }
.tiles.answer.bad { border-style: solid; border-color: var(--red); background: var(--red-soft); }
.tile { padding: 8px 14px; border: 1.5px solid var(--line); border-bottom-width: 3px; border-radius: 12px; background: #fff; font: 20px var(--serif); color: var(--es); }
.bank .tile:disabled { visibility: hidden; }
/* lesson & reading practice */
.quiz-q { padding: 12px 0; border-bottom: 1.5px solid var(--line); }
.qes { font: 21px/1.4 var(--serif); color: var(--es); margin: 0 0 2px; }
.qopts { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
.qopts button { min-height: 44px; padding: 8px 16px; border-radius: 14px; border: 1.5px solid var(--line); background: #fff; font-weight: 700; }
.qopts button[lang="es"] { font: 19px var(--serif); color: var(--es); }
.qopts button.picked { border-color: var(--blue); background: var(--blue-soft); }
.qopts button.right { border-color: var(--green); background: var(--green-soft); color: var(--green); }
.qopts button.wrong { border-color: var(--red); background: var(--red-soft); color: #C92A2A; }
.ok-t { color: var(--green); font-weight: 700; margin-top: 6px; } .bad-t { color: #C92A2A; margin-top: 6px; }
.done-mark.partial { color: #B35C00; }
.rtext { margin-top: 12px; }
.rline { padding: 12px 0; border-bottom: 1.5px solid var(--line); }
.rrow { display: flex; align-items: flex-start; gap: 10px; }
.rrow .toks { flex: 1; min-width: 0; font-size: 21px; line-height: 1.5; }
.rline .t { color: var(--ink2); margin: 4px 0 0; }
.who { font-size: 13px; font-weight: 800; color: var(--ink2); margin: 0 0 2px; }
.link { border: 0; background: none; color: var(--blue); font-weight: 700; padding: 4px 0; }
.btn[aria-pressed="true"] { border-color: var(--blue); color: var(--blue); }
/* writing */
.checks { list-style: none; padding: 0; margin: 6px 0 12px; display: grid; gap: 6px; }
.checks label, .cando label { display: flex; gap: 10px; align-items: flex-start; font-size: 15.5px; }
.checks input, .cando input { width: 20px; height: 20px; margin-top: 2px; accent-color: var(--green); flex-shrink: 0; }
.wtext { width: 100%; min-height: 150px; font: 20px/1.5 var(--serif); color: var(--es); border: 2px solid var(--line); border-radius: 16px; padding: 12px 14px; margin-top: 10px; }
.wtext:focus { outline: none; border-color: var(--blue); }
.form-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 6px; margin-top: 12px; }
.form-grid label { display: flex; justify-content: space-between; gap: 8px; margin-top: 6px; font-weight: 700; }
.form-grid input { min-height: 46px; border: 2px solid var(--line); border-radius: 12px; padding: 8px 12px; font: 19px var(--serif); color: var(--es); }
.form-grid input:focus { outline: none; border-color: var(--blue); }
.writing-accents { justify-content: flex-start; }
/* A1 goal */
.a1-card { align-items: center; }
.ring { --p: 0; width: 56px; height: 56px; border-radius: 50%; flex-shrink: 0; display: grid; place-items: center;
  background: conic-gradient(var(--green) calc(var(--p) * 1%), var(--line) 0); }
.ring span { width: 44px; height: 44px; border-radius: 50%; background: #fff; display: grid; place-items: center; font-weight: 900; font-size: 13px; }
.ring.big { width: 96px; height: 96px; } .ring.big span { width: 78px; height: 78px; font-size: 22px; }
.home .ring { width: 46px; height: 46px; } .home .ring span { width: 36px; height: 36px; font-size: 11.5px; }
.a1-top { display: flex; align-items: center; gap: 16px; margin: 14px 0 6px; }
.a1-top p { margin: 0; }
.prog { list-style: none; padding: 0; margin: 10px 0 0; display: grid; gap: 14px; }
.prog li { display: grid; gap: 4px; }
.prow { display: flex; justify-content: space-between; gap: 10px; font-weight: 700; font-size: 15.5px; }
.num { font-variant-numeric: tabular-nums; color: var(--ink2); white-space: nowrap; }
.prog .bar, .cando .bar { height: 8px; border-radius: 4px; }
.cando { list-style: none; padding: 0; margin: 8px 0 0; display: grid; gap: 14px; }
.cando li { display: grid; gap: 5px; }
.test-text p { margin: 0 0 6px; }
.test-text .toks { font-size: 19px; }
.result { margin-top: 24px; padding: 16px; border: 2px solid var(--line); border-radius: 20px; }
.result h2 { margin-top: 0; }

/* tidy: one row of plan tiles, one gloss bar, quieter word underlines */
.home .plan-nums { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
.home .pill { min-width: 0; padding: 7px 8px; font-size: 11.5px; line-height: 1.2; border-radius: 12px; }
.home .pill b { font-size: 19px; }
.tok { border-bottom-color: rgba(194, 37, 92, .18); }
.glossbar { gap: 0; }
.glossbar .gb { flex: 0 1 560px; min-width: 0; display: flex; align-items: center; gap: 6px; background: var(--ink); color: #fff; border-radius: 18px; padding: 6px 6px 6px 14px; box-shadow: 0 10px 24px -10px rgba(0,0,0,.45); }
.glossbar .gb > div { flex: 1; min-width: 0; font-size: 15px; padding: 4px 0; }
.glossbar .gb b { font-family: var(--serif); font-weight: 400; font-size: 19px; color: #FFD8E6; margin-right: 6px; }
.glossbar .gb .muted { color: #C9CCD8; }
.glossbar .gb .btn { min-height: 38px; padding: 6px 14px; background: rgba(255,255,255,.14); border: 0; color: #fff; box-shadow: none; }
.glossbar .gb .icon-btn { color: #fff; background: transparent; border: 0; box-shadow: none; width: 38px; height: 38px; }

/* ── v4.2: verb tables, grammar cards ── */
.home .plan-nums { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 5px; }
.home .pill { padding: 7px 6px; font-size: 11px; }
.home .pill b { font-size: 18px; }
.pill.gram { background: #FFF4E6; color: #B35C00; }
.k-vtable { background: #EBFBEE; color: #2B8A3E; } .k-gq { background: #FFF4E6; color: #B35C00; }
.vt-head { display: flex; align-items: center; gap: 14px; text-align: left; margin: 8px auto 4px; max-width: 420px; }
.vt-head .pic { flex-shrink: 0; margin: 0; }
.vt-pat { display: inline-block; margin-top: 4px; font-size: 13px; font-weight: 800; padding: 2px 10px; border-radius: 999px; background: var(--green-soft); color: #2B8A3E; }
.vt-grid { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 8px 12px; align-items: center; max-width: 420px; margin: 12px auto 4px; text-align: left; }
.vt-grid label { font: 18px var(--serif); color: var(--ink2); white-space: nowrap; }
.vt-cell { display: flex; align-items: center; gap: 8px; min-width: 0; }
.vt-in { flex: 1; min-width: 0; min-height: 46px; font: 21px var(--serif); color: var(--es); border: 2px solid var(--line); border-radius: 12px; padding: 6px 12px; }
.vt-in:focus { outline: none; border-color: var(--blue); }
.vt-in.ok { border-color: var(--green); background: var(--green-soft); }
.vt-in.bad { border-color: var(--red); background: var(--red-soft); color: #C92A2A; text-decoration: line-through; }
.vt-fix { font: 19px var(--serif); color: var(--green); white-space: nowrap; }
@media (max-width: 380px) { .vt-grid label { font-size: 15px; } }

