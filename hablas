nk":34},{"es":"despacio","en":"slowly","cat":"adverbs","level":"A1","pos":"adv","ex":"Habla despacio, por favor.","exEn":"Speak slowly, please.","blank":"despacio","pron":"dehs-PAH-syoh","rank":600},{"es":"juntos","en":"together","cat":"adverbs","level":"A1","pos":"adv","ex":"Estudiamos juntos.","exEn":"We study together.","blank":"juntos","pron":"HOON-tohs","rank":330},{"es":"ahora","en":"now","cat":"time","level":"A1","pos":"adv","ex":"Ahora no puedo.","exEn":"I can't right now.","blank":"Ahora","pron":"ah-OH-rah","rank":37},{"es":"luego","en":"later","cat":"time","level":"A1","pos":"adv","ex":"Te llamo luego.","exEn":"I'll call you later.","blank":"luego","pron":"LWEH-goh","rank":90},{"es":"después","en":"after","cat":"time","level":"A1","pos":"adv","ex":"Comemos después.","exEn":"We'll eat afterwards.","blank":"después","pron":"dehs-PWEHS","rank":57},{"es":"antes","en":"before","cat":"time","level":"A1","pos":"adv","ex":"Llego antes de las ocho.","exEn":"I arrive before eight.","blank":"antes","pron":"AHN-tehs","rank":61},{"es":"temprano","en":"early","cat":"time","level":"A1","pos":"adv","ex":"Llego temprano al trabajo.","exEn":"I arrive early to work.","blank":"temprano","pron":"tehm-PRAH-noh","rank":475},{"es":"pronto","en":"soon","cat":"time","level":"A1","pos":"adv","ex":"Nos vemos pronto.","exEn":"See you soon.","blank":"pronto","pron":"PROHN-toh","rank":296},{"es":"entonces","en":"then/so","cat":"talk","level":"A1","pos":"adv","ex":"¿Entonces vienes o no?","exEn":"So are you coming or not?","blank":"Entonces","pron":"ehn-TOHN-sehs","rank":102},{"es":"a veces","en":"sometimes","cat":"time","level":"A1","pos":"adv","ex":"A veces como en casa.","exEn":"Sometimes I eat at home.","blank":"A veces","pron":"ah BEH-sehs","rank":574},{"es":"de repente","en":"suddenly","cat":"time","level":"A1","pos":"adv","ex":"De repente hace frío.","exEn":"Suddenly it gets cold.","blank":"De repente","pron":"deh rreh-PEHN-teh","rank":623},{"es":"por fin","en":"finally","cat":"time","level":"A1","pos":"adv","ex":"¡Por fin es viernes!","exEn":"Finally it's Friday!","blank":"Por fin","pron":"pohr feen","rank":585},{"es":"o sea","en":"I mean","cat":"talk","level":"B1","pos":"phrase","ex":"No vino, o sea, está enfermo.","exEn":"He didn't come, I mean, he's sick.","blank":"o sea","pron":"oh SEH-ah","rank":565},{"es":"es que","en":"the thing is","cat":"talk","level":"A1","pos":"phrase","ex":"Es que no tengo tiempo.","exEn":"It's just that I don't have time.","blank":"Es que","pron":"ehs keh","rank":179},{"es":"además","en":"besides","cat":"talk","level":"A2","pos":"adv","ex":"Es caro, además no me gusta.","exEn":"It's expensive, and besides I don't like it.","blank":"además","pron":"ah-deh-MAHS","rank":106},{"es":"sin embargo","en":"however","cat":"talk","level":"B1","pos":"adv","ex":"Es difícil, sin embargo, me gusta.","exEn":"It's hard; however, I like it.","blank":"sin embargo","pron":"seen ehm-BAHR-goh","rank":598},{"es":"por eso","en":"that's why","cat":"talk","level":"A1","pos":"adv","ex":"Llueve, por eso no salgo.","exEn":"It's raining, that's why I'm not going out.","blank":"por eso","pron":"pohr EH-soh","rank":492},{"es":"a ver","en":"let's see","cat":"talk","level":"A1","pos":"phrase","ex":"A ver, ¿qué necesitas?","exEn":"Let's see, what do you need?","blank":"A ver","pron":"ah behr","rank":523},{"es":"hola","en":"hi","cat":"greet","level":"A1","pos":"interj","ex":"Hola, ¿cómo estás?","exEn":"Hi, how are you?","blank":"Hola","pron":"OH-lah","rank":0},{"es":"adiós","en":"bye","cat":"greet","level":"A1","pos":"interj","ex":"Adiós, hasta mañana.","exEn":"Bye, see you tomorrow.","blank":"Adiós","pron":"ah-DYOHS","rank":524},{"es":"gracias","en":"thanks","cat":"greet","level":"A1","pos":"interj","ex":"Muchas gracias.","exEn":"Thank you very much.","blank":"gracias","pron":"GRAH-syahs","rank":1},{"es":"por favor","en":"please","cat":"greet","level":"A1","pos":"phrase","ex":"Un café, por favor.","exEn":"A coffee, please.","blank":"por favor","pron":"pohr fah-BOHR","rank":2},{"es":"perdón","en":"sorry","cat":"greet","level":"A1","pos":"interj","ex":"Perdón, no entiendo.","exEn":"Sorry, I don't understand.","blank":"Perdón","pron":"pehr-DOHN","rank":18},{"es":"disculpe","en":"excuse me","cat":"greet","level":"A1","pos":"interj","ex":"Disculpe, ¿dónde está el baño?","exEn":"Excuse me, where's the bathroom?","blank":"Disculpe","pron":"dees-KOOL-peh","rank":608},{"es":"buenos días","en":"good morning","cat":"greet","level":"A1","pos":"phrase","ex":"Buenos días, señor.","exEn":"Good morning, sir.","blank":"Buenos días","pron":"BWEH-nohs DEE-ahs","rank":604},{"es":"buenas tardes","en":"good afternoon","cat":"greet","level":"A1","pos":"phrase","ex":"Buenas tardes, ¿cómo está?","exEn":"Good afternoon, how are you?","blank":"Buenas tardes","pron":"BWEH-nahs TAHR-dehs","rank":624},{"es":"buenas noches","en":"good night","cat":"greet","level":"A1","pos":"phrase","ex":"Buenas noches, hasta mañana.","exEn":"Good night, see you tomorrow.","blank":"Buenas noches","pron":"BWEH-nahs NOH-chehs","rank":618},{"es":"mucho gusto","en":"nice to meet you","cat":"greet","level":"A1","pos":"phrase","ex":"Mucho gusto, me llamo Ana.","exEn":"Nice to meet you, my name is Ana.","blank":"Mucho gusto","pron":"MOO-choh GOOS-toh","rank":614},{"es":"de nada","en":"you're welcome","cat":"greet","level":"A1","pos":"phrase","ex":"—Gracias. —De nada.","exEn":"“Thanks.” “You're welcome.”","blank":"De nada","pron":"deh NAH-dah","rank":506},{"es":"derecha","en":"right (side)","cat":"directions","level":"A1","pos":"noun","g":"f","ex":"El banco está a la derecha.","exEn":"The bank is on the right.","blank":"derecha","note":{"role":"derecha = the right SIDE (a la derecha = on the right). derecho = straight ahead (todo derecho). They look alike but point different ways."},"pron":"deh-REH-chah","rank":365},{"es":"izquierda","en":"left (side)","cat":"directions","level":"A1","pos":"noun","g":"f","ex":"El baño está a la izquierda.","exEn":"The bathroom is on the left.","blank":"izquierda","note":{"also":"Opposite of derecha (right)."},"pron":"ees-KYEHR-dah","rank":357},{"es":"derecho","en":"straight ahead","cat":"directions","level":"A1","pos":"adv","ex":"Sigue todo derecho.","exEn":"Keep going straight ahead.","blank":"derecho","note":{"role":"derecho = straight ahead (sigue derecho = keep going straight). The right side is derecha (a la derecha).","mean":"Also means 'a right', as in a legal right (los derechos humanos)."},"pron":"deh-REH-choh","rank":166},{"es":"esquina","en":"corner","cat":"directions","level":"A2","pos":"noun","g":"f","pl":"esquinas","ex":"La farmacia está en la esquina.","exEn":"The pharmacy is on the corner.","blank":"esquina","pron":"ehs-KEE-nah","rank":517},{"es":"cuadra","en":"block (street) (LA)","cat":"directions","level":"A2","pos":"noun","g":"f","pl":"cuadras","ex":"El hotel está a dos cuadras.","exEn":"The hotel is two blocks away.","blank":"cuadras","note":{"also":"Spain: manzana (which in Latin America only means apple)."},"pron":"KWAH-drah","rank":588},{"es":"costar","en":"to cost","cat":"verbs","level":"A2","pos":"verb","ex":"¿Cuánto cuesta el café?","exEn":"How much does the coffee cost?","blank":"cuesta","conj":{"pat":"stem o→ue","forms":[["yo","cuesto"],["tú","cuestas"],["él/ella","cuesta"],["nosotros","costamos"],["ellos/ellas","cuestan"]]},"note":{"also":"For prices you'll mostly hear cuesta (it costs) and cuestan (they cost): ¿Cuánto cuesta?","mean":"me cuesta also means 'it's hard for me': Me cuesta hablar español."},"pron":"kohs-TAHR","rank":21},{"es":"aceptar","en":"to accept","cat":"verbs","level":"A2","pos":"verb","ex":"¿Aceptan tarjeta?","exEn":"Do you take cards?","blank":"Aceptan","conj":{"pat":"regular -ar","forms":[["yo","acepto"],["tú","aceptas"],["él/ella","acepta"],["nosotros","aceptamos"],["ellos/ellas","aceptan"]]},"pron":"ah-sehp-TAHR","rank":342},{"es":"llamarse","en":"to be called (me llamo = my name is)","cat":"verbs","level":"A1","pos":"verb","ex":"Me llamo Ana. ¿Y tú, cómo te llamas?","exEn":"My name is Ana. And you, what's your name?","blank":"llamo","conj":{"pat":"reflexive -ar","forms":[["yo","me llamo"],["tú","te llamas"],["él/ella","se llama"],["nosotros","nos llamamos"],["ellos/ellas","se llaman"]]},"note":{"role":"me llamo literally means 'I call myself'. llamar without -se means to call someone: Te llamo mañana = I'll call you tomorrow."},"pron":"yah-MAHR-seh","rank":12}],"lessons":[{"id":"sounds","title":"How Spanish sounds","parts":[{"p":"Spanish is spelled almost exactly as it sounds, so once you know a handful of rules you can read any word aloud. Tap the words to hear them."},{"h":"Five short, pure vowels","p":"a, e, i, o, u never slide into a second sound the way English vowels do. Keep each one short and steady.","words":["casa","mesa","libro","todo","uno"]},{"h":"Where the stress goes","p":"Words ending in a vowel, n or s stress the second-to-last syllable: casa, hablan. Other words stress the last syllable: ciudad, hablar. A written accent overrides both rules: café, habló.","words":["casa","hablan","ciudad","hablar","café"]},{"h":"r and rr","p":"A single r between vowels is one quick tap of the tongue. rr, and r at the start of a word, is rolled. pero means but, perro means dog.","words":["pero","perro","caro","carro","rojo"]},{"h":"j, and g before e or i","p":"Both are a breathy h from the back of the throat.","words":["jugo","gente","hijo","argentino"]},{"h":"h is silent","p":"Always. hola sounds like 'ola'.","words":["hola","hoy","hermano","hotel"]},{"h":"ll and y","p":"In most of Latin America both sound like the y in 'yes'.","words":["llave","yo","calle","playa"]},{"h":"ñ","p":"Like the ny in 'canyon'.","words":["niño","mañana","español","año"]},{"h":"z, and c before e or i","p":"In Latin America these sound like s.","words":["cero","zapato","cinco","cena"]}],"ex":[]},{"id":"stress","title":"Stress and accent marks","parts":[{"p":"Words ending in a vowel, n or s are stressed on the second-to-last syllable: CA-sa, HA-blan, LU-nes. All other words are stressed on the last syllable: ciu-DAD, ha-BLAR, pa-PEL."},{"p":"A written accent breaks that rule and shows you where the stress goes: ca-FÉ, ár-bol, te-LÉ-fo-no."},{"p":"Some accents tell two different words apart. They sound the same, so in speech the sentence decides."},{"words":["tú","tu","él","el","sí","si","mí","mi"],"p":"tú = you, tu = your · él = he, el = the · sí = yes, si = if · mí = me, mi = my"},{"p":"Question words always carry an accent: qué, quién, dónde, cuándo, cómo, cuánto, por qué."}],"ex":[["¿Dónde está el café?","Where is the coffee?"],["Sí, es mi teléfono.","Yes, it's my phone."]]},{"id":"g_articles","title":"Every noun is masculine or feminine","parts":[{"p":"Use el or un with masculine nouns, la or una with feminine ones. Plurals take los or las. Most nouns ending in -o are masculine and most ending in -a are feminine, so learn each noun together with its article."},{"h":"Watch out","p":"A few common words break the -o / -a pattern: el día, el mapa, el problema, el idioma (masculine) and la mano, la foto (feminine). el agua is feminine but takes el because it starts with a stressed a."}],"ex":[["el libro","the book"],["la casa","the house"]]},{"id":"plurals","title":"Making plurals","parts":[{"p":"Ends in a vowel: add -s. casa → casas, café → cafés."},{"p":"Ends in a consonant: add -es. papel → papeles, ciudad → ciudades, mes → meses."},{"p":"Ends in -z: change it to -ces. vez → veces, nariz → narices."},{"p":"An accent on the last syllable disappears when -es is added, because the stress rule now does its job: estación → estaciones, autobús → autobuses. And examen gains one: exámenes."},{"p":"Words ending in an unstressed -s don't change: el lunes → los lunes."},{"p":"The article changes too: el → los, la → las, un → unos, una → unas."}],"ex":[["los libros y las casas","the books and the houses"],["Tengo dos hermanos.","I have two brothers."]]},{"id":"g_adj","title":"Adjectives match their noun","parts":[{"p":"Adjectives usually come after the noun and change to match it: -o, -a, -os, -as. Adjectives ending in -e or a consonant only change for plural."}],"ex":[["la casa bonita","the pretty house"],["los carros rojos","the red cars"]]},{"id":"g_pron","title":"Subject pronouns, and three ways to say you","parts":[{"p":"yo (I), tú (you, casual), usted (you, polite), él / ella (he / she), nosotros (we), ustedes (you all), ellos / ellas (they). In Latin America ustedes is used for any group. Spanish often drops the pronoun because the verb ending already says who."}],"ex":[["Tú hablas español.","You speak Spanish."],["Usted habla muy bien.","You (polite) speak very well."]]},{"id":"g_ar","title":"Present tense of -ar verbs","parts":[{"p":"Take off -ar and add -o, -as, -a, -amos, -an for I, you, he/she, we, they. hablar becomes hablo, hablas, habla, hablamos, hablan."}],"ex":[["Hablo español.","I speak Spanish."],["Ellos trabajan aquí.","They work here."]]},{"id":"g_erir","title":"Present tense of -er and -ir verbs","parts":[{"p":"Take off -er and add -o, -es, -e, -emos, -en. comer becomes como, comes, come, comemos, comen."},{"p":"Same endings as -er verbs except for we: -o, -es, -e, -imos, -en. vivir becomes vivo, vives, vive, vivimos, viven."}],"ex":[["Comemos en casa.","We eat at home."],["¿Bebes café?","Do you drink coffee?"],["Vivo en la ciudad.","I live in the city."],["Escribimos mensajes.","We write messages."]]},{"id":"g_irreg","title":"The everyday irregular verbs","parts":[{"p":"The most common verbs break the rules, so learn their forms as words: ser (soy, eres, es), ir (voy, vas, va), tener (tengo, tienes, tiene), hacer (hago, haces, hace)."}],"ex":[["Voy al mercado.","I'm going to the market."],["¿Qué haces?","What are you doing?"]]},{"id":"g_serestar","title":"Two verbs for 'to be': ser and estar","parts":[{"p":"ser says what something is: identity, origin, job, lasting traits, time. estar says where something is and how it is right now: location, feelings, temporary states."}],"ex":[["Soy de México.","I'm from Mexico. (origin, ser)"],["Estoy cansado.","I'm tired. (a state, estar)"]]},{"id":"g_hay","title":"hay: there is, there are","parts":[{"p":"One word for both singular and plural. Use it to say that something exists. To say where a specific, known thing is, use estar instead."}],"ex":[["Hay un banco cerca.","There's a bank nearby."],["El banco está cerca.","The bank is nearby."]]},{"id":"g_neg","title":"Saying no","parts":[{"p":"Put no right before the verb. nunca (never) and nadie (nobody) can go before the verb, or after it with no in front. That double negative is correct Spanish."}],"ex":[["No entiendo.","I don't understand."],["No hay nadie en casa.","There's nobody home."]]},{"id":"g_ques","title":"Asking questions","parts":[{"p":"Question words carry an accent: qué, quién, dónde, cuándo, cómo, cuánto, por qué. Written questions open with ¿ and close with ?. Yes-or-no questions just raise the voice at the end."}],"ex":[["¿Dónde está el baño?","Where's the bathroom?"],["¿Hablas español?","Do you speak Spanish?"]]},{"id":"g_num","title":"Numbers and telling the time","parts":[{"p":"¿Qué hora es? Es la una for one o'clock, son las dos (or three, four…) for the rest. y media adds half an hour, y cuarto a quarter."}],"ex":[["Son las tres y media.","It's three thirty."],["La clase es a las nueve.","The class is at nine."]]},{"id":"g_conn","title":"Linking ideas: y, pero, porque","parts":[{"p":"y is and, pero is but, porque is because (in answers), and por qué is why (in questions)."}],"ex":[["Es caro, pero es bueno.","It's expensive, but it's good."],["No voy porque estoy cansado.","I'm not going because I'm tired."]]},{"id":"g_stem","title":"Verbs whose middle vowel changes","parts":[{"p":"In some verbs the stressed vowel changes in every form except we: e becomes ie (quiero), o becomes ue (puedo), e becomes i (pido). The endings stay regular."}],"ex":[["Quiero un café.","I want a coffee."],["¿Puedes ayudarme?","Can you help me?"]]},{"id":"g_tener","title":"Things you 'have' in Spanish","parts":[{"p":"Spanish uses tener where English uses 'to be': tener … años (age), tener hambre (hungry), tener frío (cold), tener calor (hot). tener que + verb means 'have to'."}],"ex":[["Tengo treinta años.","I'm thirty years old."],["Tengo que estudiar.","I have to study."]]},{"id":"g_gustar","title":"gustar works backwards","parts":[{"p":"The thing you like is the subject: me gusta el café means 'coffee pleases me'. If the thing is plural, use gustan. me, te, le, nos, les show who likes it."}],"ex":[["Me gusta el café.","I like coffee."],["Me gustan los frijoles.","I like beans."]]},{"id":"g_poss","title":"my, your, his: mi, tu, su","parts":[{"p":"mi is my, tu is your, su is his, her, their or your (polite). Add -s when the noun is plural: mis hermanos."}],"ex":[["Mi hermano es médico.","My brother is a doctor."],["¿Dónde está tu celular?","Where's your phone?"]]},{"id":"g_dem","title":"this and that: este, ese, aquel","parts":[{"p":"este is this (near me), ese is that (near you), aquel is that over there. They match the noun: esta casa, esa mesa. esto and eso mean 'this thing' and 'that thing'."}],"ex":[["Este es mi amigo.","This is my friend."],["¿Qué es eso?","What's that?"]]},{"id":"g_prep","title":"Small words with big jobs: a, de, en, con","parts":[{"p":"a means to or at, de means of or from, en means in, on or at, con means with. a + el becomes al, and de + el becomes del."}],"ex":[["Voy al mercado.","I'm going to the market."],["Vivo con mi familia.","I live with my family."]]},{"id":"g_fut","title":"Talking about plans: ir a + verb","parts":[{"p":"voy a + any verb means 'I'm going to…'. It's the easiest way to talk about the future."}],"ex":[["Voy a viajar a Perú.","I'm going to travel to Peru."],["¿Qué vas a hacer mañana?","What are you going to do tomorrow?"]]},{"id":"g_refl","title":"Doing it to yourself: reflexive verbs","parts":[{"p":"Verbs listed with -se (levantarse) take me, te, se, nos, se before the verb. Most daily-routine verbs work this way."}],"ex":[["Me levanto temprano.","I get up early."],["¿Cómo te llamas?","What's your name?"]]},{"id":"g_prog","title":"Happening right now: estar + -ando / -iendo","parts":[{"p":"-ar verbs become -ando (hablando), -er and -ir verbs become -iendo (comiendo, viviendo). Use it for actions in progress at this moment."}],"ex":[["Estoy estudiando.","I'm studying."],["Los niños están durmiendo.","The children are sleeping."]]},{"id":"g_obj","title":"me, te, lo, la as objects","parts":[{"p":"These go right before the conjugated verb: te llamo means 'I call you'. lo and la mean him, her or it. With an infinitive they can join the end: ayudarme."}],"ex":[["Ella me llama.","She calls me."],["No lo conozco.","I don't know him."]]},{"id":"g_comp","title":"Comparing: más … que","parts":[{"p":"más + adjective + que means 'more … than', menos … que means 'less … than'. Two are irregular: mejor (better) and peor (worse)."}],"ex":[["Él es más alto que yo.","He's taller than me."],["El café es mejor que el té.","Coffee is better than tea."]]}],"sents":[{"id":"h0","es":"Hola, ¿cómo estás?","en":"Hello, how are you?","unit":1,"g":["g_serestar","g_ques","g_irreg"],"fn":"greet","hand":true,"target":null,"t":[["Hola,","hello","hola"],["¿cómo","how","cómo"],["estás?","are (you)","estar"]],"lem":["hola","cómo","estar"],"tiles":["Hola","cómo","estás"]},{"id":"h1","es":"Buenos días, mucho gusto.","en":"Good morning, nice to meet you.","unit":1,"g":["g_adj"],"fn":"greet","hand":true,"target":null,"t":[["Buenos","good","bueno"],["días,","days → 'buenos días' = good morning","día"],["mucho","much","mucho"],["gusto.","pleasure → 'mucho gusto' = nice to meet you",""]],"lem":["bueno","día","mucho"],"tiles":["Buenos","días","mucho","gusto"]},{"id":"h2","es":"¿Cómo te llamas? —Me llamo Ana.","en":"What's your name? — My name is Ana.","unit":1,"g":["g_refl","g_ques"],"fn":"intro","hand":true,"target":